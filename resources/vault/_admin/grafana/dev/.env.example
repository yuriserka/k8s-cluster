OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64_encoded_credentials>

# Default: Grafana OTLP with throttled metrics (5 min). Copy to .env and set ENDPOINT/HEADERS
# from Grafana Cloud → your stack → OpenTelemetry → Configure.

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=300000 # 5 minutes
OTEL_METRIC_EXPORT_TIMEOUT=10000 # 10 seconds
