# syntax=docker/dockerfile:1
ARG CONTAINER=api

FROM gradle:8.9-jdk21-alpine AS builder
ARG CONTAINER
WORKDIR /usr/src/java-code
COPY . .
RUN --mount=type=cache,target=/home/gradle/.gradle \
    gradle :app:containers:${CONTAINER}:bootJar --no-daemon

FROM eclipse-temurin:21-jre-alpine
ARG CONTAINER
WORKDIR /usr/src/java-app
COPY --from=builder /usr/src/java-code/app/containers/${CONTAINER}/build/libs/*.jar ./app.jar
ADD https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.15.0/opentelemetry-javaagent.jar /app/opentelemetry-javaagent.jar
COPY app/containers/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8080

ENV SPRING_PROFILE=local
ENV APP_JAR=app.jar
ENV OTEL_SERVICE_NAME=kafka-producer-${CONTAINER}
ENV OTEL_TRACES_EXPORTER=none
ENV OTEL_METRICS_EXPORTER=none
ENV OTEL_LOGS_EXPORTER=none
ENV OTEL_RESOURCE_ATTRIBUTES="service.name=kafka-producer-${CONTAINER},service.namespace=local,deployment.environment=local"
ENV OTEL_JAVAAGENT_ENABLED=false

ENTRYPOINT ["/docker-entrypoint.sh"]
