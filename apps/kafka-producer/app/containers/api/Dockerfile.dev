# syntax=docker/dockerfile:1

FROM gradle:8.9-jdk21-alpine AS cache
RUN mkdir -p /home/gradle/cache_home
ENV GRADLE_USER_HOME=/home/gradle/cache_home
COPY build.gradle settings.gradle gradle.properties /home/gradle/java-code/
COPY config/ /home/gradle/java-code/config/
COPY app/build.gradle /home/gradle/java-code/app/
COPY app/core/build.gradle /home/gradle/java-code/app/core/
COPY app/containers/build.gradle /home/gradle/java-code/app/containers/
COPY app/containers/api/build.gradle /home/gradle/java-code/app/containers/api/
WORKDIR /home/gradle/java-code
RUN gradle :app:containers:api:clean :app:containers:api:build -x bootJar --no-daemon

FROM gradle:8.9-jdk21-alpine AS builder
COPY --from=cache /home/gradle/cache_home /home/gradle/.gradle
COPY . /usr/src/java-code/
WORKDIR /usr/src/java-code

# Static analysis — same as .pipeline lint
RUN gradle codeChecks -x bootJar --no-daemon

# Tests + coverage — same as .pipeline test; Testcontainers uses host docker.sock
RUN --mount=type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock \
    gradle test -x bootJar --no-daemon

RUN gradle :app:containers:api:bootJar --no-daemon

FROM eclipse-temurin:21-jre-alpine
WORKDIR /usr/src/java-app
COPY --from=builder /usr/src/java-code/app/containers/api/build/libs/*.jar ./api.jar
ADD https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.15.0/opentelemetry-javaagent.jar /app/opentelemetry-javaagent.jar
COPY app/containers/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8080

ENV SPRING_PROFILE=local
ENV APP_JAR=api.jar
ENV OTEL_SERVICE_NAME=kafka-producer-api
ENV OTEL_TRACES_EXPORTER=none
ENV OTEL_METRICS_EXPORTER=none
ENV OTEL_LOGS_EXPORTER=none
ENV OTEL_RESOURCE_ATTRIBUTES="service.name=kafka-producer-api,service.namespace=local,deployment.environment=local"
ENV OTEL_JAVAAGENT_ENABLED=false

ENTRYPOINT ["/docker-entrypoint.sh"]
