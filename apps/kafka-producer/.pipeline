steps:
  clone-app:
    kind: clone

  install:
    depends_on: clone-app
    cmd:
      - "./gradlew clean assemble -x bootJar"

  lint:
    depends_on: install
    cmd:
      - "./gradlew codeChecks"

  test:
    depends_on: lint
    cmd:
      - "./gradlew test -x bootJar"

  build:
    depends_on: test
    cmd:
      - "./gradlew bootJar"

  dev-publish-migrate:
    depends_on: build
    kind: publish
    repo: kafka-producer-migrate
    dockerfile: app/containers/migrate/Dockerfile
    env: dev

  dev-migrate:
    depends_on: dev-publish-migrate
    kind: database_migration
    env: dev
    repository: kafka-producer
    image_repo: kafka-producer-migrate
    cmd:
      - /docker-entrypoint.sh migrate

  dev-publish-api:
    depends_on: dev-migrate
    kind: publish
    repo: kafka-producer-api
    dockerfile: app/containers/Dockerfile
    build_args:
      CONTAINER: api
    env: dev

  dev-publish-scheduler:
    depends_on: dev-migrate
    kind: publish
    repo: kafka-producer-scheduler
    dockerfile: app/containers/Dockerfile
    build_args:
      CONTAINER: scheduler
    env: dev

  dev-deploy-api:
    depends_on: dev-publish-api
    kind: install
    repo: kafka-producer
    application: kafka-producer-api
    params_file: api.yaml
    env: dev

  dev-deploy-scheduler:
    depends_on: dev-publish-scheduler
    kind: install
    repo: kafka-producer
    application: kafka-producer-scheduler
    params_file: scheduler.yaml
    env: dev
