root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle,kts}]
indent_style = space
indent_size = 2
max_line_length = 100
# Wrapped records, method signatures, and calls: put closing ')' on its own line.

[*.md]
trim_trailing_whitespace = false
